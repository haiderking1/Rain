<Window x:Class="Rain.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Rain"
        Title="{Binding WindowTitle}"
        Width="1100" Height="700" MinWidth="780" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        UseLayoutRounding="True"
        PreviewKeyDown="OnPreviewKeyDown">

    <Window.Resources>
        <DataTemplate x:Key="TrackTemplate" DataType="{x:Type local:Track}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26"/>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="52"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="icon" FontFamily="{StaticResource Icons}" Text="&#xE767;" FontSize="12"
                           Foreground="{StaticResource Accent}" VerticalAlignment="Center" Visibility="Hidden"/>
                <TextBlock x:Name="title" Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis" Margin="0,0,16,0"/>
                <TextBlock Grid.Column="2" Text="{Binding Artist}" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,0,16,0"/>
                <TextBlock Grid.Column="3" Text="{Binding Album}" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,0,16,0"/>
                <TextBlock Grid.Column="4" Text="{Binding DurationText}" Foreground="{StaticResource Dim}" HorizontalAlignment="Right"/>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter TargetName="icon" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="title" Property="Foreground" Value="{StaticResource Accent}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Margin="24,18,24,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Rain" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Status}" Foreground="{StaticResource Muted}" FontSize="12" Margin="1,2,0,0"/>
            </StackPanel>
            <TextBox x:Name="SearchBox" Grid.Column="2" Width="260" Style="{StaticResource InputBox}" local:Ui.Icon="&#xE721;"
                     Tag="Search  (Ctrl+F)" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
            <Button AutomationProperties.Name="Download" Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE896;" Margin="8,0,0,0"
                    ToolTip="Download from a link" Tag="{Binding IsDownloadOpen}" Command="{Binding ToggleDownloadCommand}"/>
            <Button AutomationProperties.Name="Choose folder" Grid.Column="4" Style="{StaticResource IconButton}" Content="&#xED25;" Margin="2,0,0,0"
                    ToolTip="Choose music folder" Command="{Binding OpenFolderCommand}"/>
        </Grid>

        <!-- Download panel -->
        <Border Grid.Row="1" Margin="24,0,24,14" Padding="14,12" CornerRadius="10"
                Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                Visibility="{Binding IsDownloadOpen, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="UrlBox" Style="{StaticResource InputBox}" local:Ui.Icon="&#xE71B;"
                             Tag="Paste a YouTube, SoundCloud or Bandcamp link"
                             Text="{Binding DownloadUrl, UpdateSourceTrigger=PropertyChanged}" KeyDown="UrlBox_KeyDown"/>
                    <Button AutomationProperties.Name="Start download" Grid.Column="1" Style="{StaticResource PillButton}" Margin="10,0,0,0"
                            MinWidth="110" Content="{Binding DownloadButtonText}" Command="{Binding DownloadCommand}"/>
                </Grid>
                <StackPanel Margin="4,10,4,0" Visibility="{Binding HasDownloadStatus, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding DownloadStatus}" Foreground="{StaticResource Muted}" FontSize="12"
                               TextTrimming="CharacterEllipsis"/>
                    <ProgressBar Style="{StaticResource ThinProgress}" Margin="0,8,0,0" Maximum="100" Value="{Binding DownloadProgress, Mode=OneWay}"
                                 Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Track list -->
        <Grid Grid.Row="2" Margin="12,0,12,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Grid Margin="12,0,20,6" TextElement.Foreground="{StaticResource Dim}" TextElement.FontSize="11">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26"/>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="52"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="1" Text="TITLE"/>
                <TextBlock Grid.Column="2" Text="ARTIST"/>
                <TextBlock Grid.Column="3" Text="ALBUM"/>
                <TextBlock Grid.Column="4" Text="&#xE916;" FontFamily="{StaticResource Icons}" HorizontalAlignment="Right"/>
            </Grid>

            <ListBox x:Name="TrackList" Grid.Row="1" Style="{StaticResource TrackList}"
                     ItemsSource="{Binding TracksView}" SelectedItem="{Binding SelectedTrack}"
                     ItemTemplate="{StaticResource TrackTemplate}"
                     MouseDoubleClick="TrackList_MouseDoubleClick"/>

            <StackPanel Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource Icons}" FontSize="40"
                           Foreground="{StaticResource Dim}" HorizontalAlignment="Center"/>
                <TextBlock Text="No music yet" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,4"/>
                <TextBlock Text="Point Rain at the folder with your music." Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/>
                <Button Style="{StaticResource PillButton}" Content="Choose folder" HorizontalAlignment="Center" Margin="0,18,0,0"
                        Command="{Binding OpenFolderCommand}"/>
            </StackPanel>
        </Grid>

        <!-- Player bar -->
        <Border Grid.Row="3" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <!-- Now playing -->
                <Grid VerticalAlignment="Center" Margin="0,0,16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="56" Height="56">
                        <Border Background="{StaticResource Hover}" CornerRadius="6">
                            <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource Icons}" FontSize="20"
                                       Foreground="{StaticResource Dim}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border CornerRadius="6">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                        <TextBlock Text="{Binding CurrentTrack.Title, FallbackValue='Nothing playing', TargetNullValue='Nothing playing'}"
                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding CurrentTrack.Artist}" Foreground="{StaticResource Muted}" FontSize="12"
                                   TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- Transport + seek -->
                <StackPanel Grid.Column="1" Width="480">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button AutomationProperties.Name="Shuffle" Style="{StaticResource IconButton}" Content="&#xE8B1;" FontSize="13" ToolTip="Shuffle"
                                Tag="{Binding IsShuffle}" Command="{Binding ShuffleCommand}"/>
                        <Button AutomationProperties.Name="Previous" Style="{StaticResource IconButton}" Content="&#xE892;" Margin="10,0,0,0" ToolTip="Previous"
                                Command="{Binding PreviousCommand}"/>
                        <Button AutomationProperties.Name="Play/Pause" ToolTip="Play/Pause (Space)" Style="{StaticResource PlayButton}" Content="{Binding PlayGlyph}" Margin="10,0"
                                Command="{Binding PlayPauseCommand}"/>
                        <Button AutomationProperties.Name="Next" Style="{StaticResource IconButton}" Content="&#xE893;" Margin="0,0,10,0" ToolTip="Next"
                                Command="{Binding NextCommand}"/>
                        <Button AutomationProperties.Name="Repeat" Style="{StaticResource IconButton}" Content="{Binding RepeatGlyph}" FontSize="13"
                                ToolTip="{Binding RepeatTip}" Tag="{Binding IsRepeatOn}" Command="{Binding RepeatCommand}"/>
                    </StackPanel>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="44"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding PositionText}" Foreground="{StaticResource Dim}" FontSize="11" VerticalAlignment="Center"/>
                        <Slider Grid.Column="1" Style="{StaticResource ThinSlider}" Minimum="0"
                                Maximum="{Binding Duration}" Value="{Binding Position}" IsEnabled="{Binding HasTrack}"
                                Thumb.DragStarted="Seek_DragStarted" Thumb.DragCompleted="Seek_DragCompleted"/>
                        <TextBlock Grid.Column="2" Text="{Binding DurationText}" Foreground="{StaticResource Dim}" FontSize="11"
                                   VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>

                <!-- Volume -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button AutomationProperties.Name="Mute" Style="{StaticResource IconButton}" Content="{Binding VolumeGlyph}" ToolTip="Mute"
                            Command="{Binding MuteCommand}"/>
                    <Slider Width="110" Margin="4,0,0,0" Style="{StaticResource ThinSlider}" Minimum="0" Maximum="1"
                            Value="{Binding Volume}" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
